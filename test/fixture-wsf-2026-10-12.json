[{"BulletinID":119049,"BulletinFlag":true,"BulletinText":"<p>The elevator on the M\/V Yakima is back in service and available for customer use.<\/p>","CommunicationFlag":false,"CommunicationText":null,"RouteAlertFlag":true,"RouteAlertText":"Ana\/SJs - Update - ADA Alert - Yakima passenger elevator back in service","HomepageAlertText":"<p>The elevator on the M\/V Yakima is back in service and available for customer use.<\/p>","PublishDate":"\/Date(1791825236330-0700)\/","DisruptionDescription":null,"AllRoutesFlag":false,"SortSeq":6,"AlertTypeID":5,"AlertType":"All Alerts","AlertFullTitle":"Ana\/SJs - Update - ADA Alert - Yakima passenger elevator back in service","AffectedRouteIDs":[9,20,21,22,23,27,28,272],"IVRText":null},{"BulletinID":113728,"BulletinFlag":true,"BulletinText":"<p><span data-contrast=\"none\">The <a href=\"https:\/\/wsdotblog.blogspot.com\/2026\/04\/smoother-sailing-in-kingston-new-sr-104.html\" target=\"_blank\" rel=\"noopener\">traffic signal and boarding pass system<\/a> at the Kingston terminal is active daily from 8 a.m. to 8 p.m. through Indigenous Peoples’ Day on Oct. 12. The boarding pass holds your vehicle's place in line. Ferry tickets are purchased separately. <\/span><\/p>\u000d\u000a<p><b><span data-contrast=\"none\">A boarding pass for vehicles is required before arriving at the terminal ticket booth<\/span><\/b><\/p>\u000d\u000a<ol>\u000d\u000a<li><span data-contrast=\"none\">Follow the signal: Ferry-bound traffic will follow the traffic signal on SR 104 into a designated lane.  <a href=\"https:\/\/blogger.googleusercontent.com\/img\/b\/R29vZ2xl\/AVvXsEijmKFjky_8eHV13k7Cv-0iD1zUzSx_a5Qee2rRp6bii-0fY_5FWTSbq1KDcbypKPoc-MyrNWRexlLN978iUo7KHHC1cVSTiyOZnmA8TLLq5YJZ89sUbktd61IeslD4IQ3LtGqW5VNNkFovd39XkVHs8nlVRkAA7AN66PfFkE5ZOmtvBAV1zqugOnIACrs\/s1218\/Kingston-ATMS-Map.gif\" target=\"_blank\" rel=\"noopener\">View map<\/a>. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Take a pass: Stop at the automated dispenser and take your pass. If you leave the line after taking a pass, you will need to re-enter the line and take a new pass. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Wait for Green: Once the system detects space at the terminal, your light will turn green. Proceed directly to the tollbooths. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<\/ol>\u000d\u000a<p><b><span data-contrast=\"none\">Standard operating days and times<\/span><\/b><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>\u000d\u000a<p><span data-contrast=\"none\">A boarding pass for vehicles is required from 8 a.m. to 8 p.m. during these peak periods: <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>\u000d\u000a<ul>\u000d\u000a<li><span data-contrast=\"none\">Summer Season: Daily from Mother’s Day through Indigenous Peoples’ Day. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Year-Round: Every Saturday and Sunday. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Holidays: Daily during the weeks of Thanksgiving, Christmas, and New Year’s. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<\/ul>\u000d\u000a<p><span data-contrast=\"none\">The purpose of this system is to help improve traffic flow through Kingston and deter ferry line cutting. We are monitoring how the system is working and will make adjustments as needed to improve operations. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>","CommunicationFlag":false,"CommunicationText":null,"RouteAlertFlag":true,"RouteAlertText":"Edm\/King- Boarding pass required daily, 8 a.m. to 8 p.m. through Oct.12","HomepageAlertText":"<p><span data-contrast=\"none\">The <a href=\"https:\/\/wsdotblog.blogspot.com\/2026\/04\/smoother-sailing-in-kingston-new-sr-104.html\" target=\"_blank\" rel=\"noopener\">traffic signal and boarding pass system<\/a> at the Kingston terminal is active daily from 8 a.m. to 8 p.m. through Indigenous Peoples’ Day on Oct. 12. The boarding pass holds your vehicle's place in line. Ferry tickets are purchased separately. <\/span><\/p>\u000d\u000a<p><b><span data-contrast=\"none\">A boarding pass for vehicles is required before arriving at the terminal ticket booth<\/span><\/b><\/p>\u000d\u000a<ol>\u000d\u000a<li><span data-contrast=\"none\">Follow the signal: Ferry-bound traffic will follow the traffic signal on SR 104 into a designated lane.  <a href=\"https:\/\/blogger.googleusercontent.com\/img\/b\/R29vZ2xl\/AVvXsEijmKFjky_8eHV13k7Cv-0iD1zUzSx_a5Qee2rRp6bii-0fY_5FWTSbq1KDcbypKPoc-MyrNWRexlLN978iUo7KHHC1cVSTiyOZnmA8TLLq5YJZ89sUbktd61IeslD4IQ3LtGqW5VNNkFovd39XkVHs8nlVRkAA7AN66PfFkE5ZOmtvBAV1zqugOnIACrs\/s1218\/Kingston-ATMS-Map.gif\" target=\"_blank\" rel=\"noopener\">View map<\/a>. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Take a pass: Stop at the automated dispenser and take your pass. If you leave the line after taking a pass, you will need to re-enter the line and take a new pass. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Wait for Green: Once the system detects space at the terminal, your light will turn green. Proceed directly to the tollbooths. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<\/ol>\u000d\u000a<p><b><span data-contrast=\"none\">Standard operating days and times<\/span><\/b><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>\u000d\u000a<p><span data-contrast=\"none\">A boarding pass for vehicles is required from 8 a.m. to 8 p.m. during these peak periods: <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>\u000d\u000a<ul>\u000d\u000a<li><span data-contrast=\"none\">Summer Season: Daily from Mother’s Day through Indigenous Peoples’ Day. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Year-Round: Every Saturday and Sunday. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<li><span data-contrast=\"none\">Holidays: Daily during the weeks of Thanksgiving, Christmas, and New Year’s. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/li>\u000d\u000a<\/ul>\u000d\u000a<p><span data-contrast=\"none\">The purpose of this system is to help improve traffic flow through Kingston and deter ferry line cutting. We are monitoring how the system is working and will make adjustments as needed to improve operations. <\/span><span data-ccp-props=\"{&quot;134233117&quot;:false,&quot;134233118&quot;:false,&quot;201341983&quot;:0,&quot;335551550&quot;:1,&quot;335551620&quot;:1,&quot;335557856&quot;:16777215,&quot;335559685&quot;:0,&quot;335559737&quot;:0,&quot;335559738&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:259}\"> <\/span><\/p>","PublishDate":"\/Date(1788118945407-0700)\/","DisruptionDescription":null,"AllRoutesFlag":false,"SortSeq":10,"AlertTypeID":5,"AlertType":"All Alerts","AlertFullTitle":"Edm\/King - Boarding pass required daily, 8 a.m. to 8 p.m. through Oct.12","AffectedRouteIDs":[6],"IVRText":null}]